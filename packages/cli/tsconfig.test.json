{
  // The composite build excludes *.test.ts so tests never land in dist/ — which
  // also means `tsc --build` never checks them. This config does, with no emit.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": []
}
